    "plugin.translate.settings.systemHint" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses Apple Translation on macOS 15 or later. The system may download language packs on first use. Selection is used first; otherwise clipboard text."
