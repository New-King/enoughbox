        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 macOS 15 及以上的系统翻译。首次使用时系统可能会下载语言包。优先划词，没有选中则用剪贴板。"
          }
        }
