    "plugin.screenshot.settings.colorHint" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move the pointer to sample color in the magnifier. Press ⌘C to copy the HEX value."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移动指针可在放大镜中取色。按 ⌘C 复制色值。"
          }
        }
      }
    },
    "plugin.screenshot.settings.hint" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needs Screen Recording permission. Hover to snap to a window; click to select it, or drag for a custom region. Then resize, mosaic, pin, save, copy, or cancel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要屏幕录制权限。悬停可吸附窗口，单击选中；按住拖动可自定义区域。之后可调大小、马赛克、钉图、保存、复制或取消。"
          }
        }
      }
    },
