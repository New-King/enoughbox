    "plugin.screenshot.settings.colorHint" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While capturing, the pointer shows HEX/RGB. Press / to copy that color and leave capture."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截图过程中指针旁会显示 HEX/RGB。按 / 复制该颜色并结束本次截图。"
          }
        }
      }
    },
    "plugin.screenshot.settings.hint" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Needs Screen Recording permission. After a region is selected you can resize it, mosaic, pin, save, copy, or cancel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要屏幕录制权限。框选后可再调大小，也可马赛克、钉图、保存、复制或取消。"
          }
        }
      }
    },
